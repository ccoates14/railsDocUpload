<div style="text-align: center; padding: 2rem;">
    <h1>Upload a File</h1>
    
    <%= form_with model: @file, url: content_items_path, local: true, html: { multipart: true } do |form| %>    
        <div style="margin-bottom: 1rem;">
        <%= form.label :file, "Choose File", style: "display: block; margin-bottom: 0.5rem;" %>
        <%= form.file_field :file, required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" %>
        </div>
    
        <div>
        <%= form.submit "Upload", style: "background-color: #007bff; color: white; padding: 0.5rem 1rem; border: none; border-radius: 4px; cursor: pointer;" %>
        </div>
    <% end %>
</div>